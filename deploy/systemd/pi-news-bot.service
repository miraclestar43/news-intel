[Unit]
Description=pi-news-intel: Telegram long-polling bot (Phase 2 — not yet implemented)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/pi-news-intel
# Placeholder: `pi-news bot run` (long polling, /brief /status /help) does
# not exist until Phase 2. Do not enable until implemented and reviewed.
ExecStart=%h/pi-news-intel/.venv/bin/pi-news bot run
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
