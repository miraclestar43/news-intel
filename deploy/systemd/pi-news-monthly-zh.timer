[Unit]
Description=pi-news-intel: zh_cn monthly brief, first Monday 07:00 America/Los_Angeles (DST-aware)

[Timer]
# "Mon *-*-01..07 07:00:00" is the standard systemd idiom for "the first
# Monday of the month, 07:00" -- same construction as pi-news-monthly.timer.
OnCalendar=Mon *-*-01..07 07:00:00 America/Los_Angeles
# Persistent=true is required (task spec), but the production monthly
# entrypoint itself (jobs/monthly_production.py's _is_valid_monthly_window,
# edition-aware) independently rejects execution outside an explicitly
# valid first-Monday Pacific window BEFORE any job-run/digest/delivery
# record is created -- never rely on systemd timer behavior alone.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
