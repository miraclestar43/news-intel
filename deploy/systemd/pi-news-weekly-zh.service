[Unit]
Description=pi-news-intel: normal production Chinese (zh_cn) weekly brief (Sunday synthesis)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/pi-news-intel
EnvironmentFile=%h/pi-news-intel/.env
ExecStart=%h/pi-news-intel/.venv/bin/pi-news production weekly --edition zh_cn
TimeoutStartSec=280
