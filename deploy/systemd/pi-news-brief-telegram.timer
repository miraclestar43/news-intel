[Unit]
Description=pi-news-intel: Telegram send of the daily brief, 21:00 Asia/Shanghai

[Timer]
# After both build runs (20:05, 20:50). An edition that is still not frozen at 21:00 is not sent that day.
OnCalendar=*-*-* 21:00:00 Asia/Shanghai
Persistent=false
AccuracySec=1min

[Install]
WantedBy=timers.target
