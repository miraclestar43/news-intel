[Unit]
Description=pi-news-intel: monthly brief, first Monday 22:00 America/Los_Angeles (DST-aware)

[Timer]
# "Mon *-*-01..07 22:00:00" is the standard systemd idiom for "the first
# Monday of the month, 22:00" -- day-of-month restricted to 1..7 combined
# with the Mon weekday filter can only ever match the first Monday. Same
# timezone-aware expression style as pi-news-weekly.timer (NOT a fixed-UTC
# OnCalendar) -- systemd resolves America/Los_Angeles against the correct
# DST offset at each firing.
OnCalendar=Mon *-*-01..07 22:00:00 America/Los_Angeles
# Persistent=true is required (task spec), but the production monthly
# entrypoint itself (jobs/monthly_production.py's _is_valid_monthly_window)
# independently rejects execution outside an explicitly valid first-Monday
# Pacific window BEFORE any job-run/digest/delivery record is created --
# this is what actually prevents a late catch-up firing (e.g. installing
# this timer days after a missed first Monday) from producing a delayed
# send. Never rely on systemd timer behavior alone for this protection.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
