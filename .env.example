TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Alternate LLM provider mode (2026-08-24): set LLM_PROVIDER=hermes_cli to
# shell out to an already-configured local Hermes CLI instead of the
# LLM_BASE_URL/LLM_API_KEY/LLM_MODEL HTTP path above. None of these three
# are secrets -- HERMES_BIN is a filesystem path this project resolves and
# stores itself (e.g. via `command -v hermes`); this project never reads
# Hermes's own config.yaml/.env to discover it.
LLM_PROVIDER=
HERMES_BIN=
HERMES_TIMEOUT_SECONDS=
HERMES_MODEL_LABEL=
SEC_USER_AGENT=PiNewsIntel contact@example.com
GUARDIAN_API_KEY=
